# ==============================================================================
# AgriVision AI — Production Backend Environment Variables Configuration Template
# ==============================================================================

# Core Application
ENVIRONMENT=development
DEBUG=True
JWT_SECRET=your_jwt_secret_key_change_in_production

# Database (MongoDB Atlas or Local MongoDB)
# Leave empty to use resilient local persistence repository if testing locally
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/
DATABASE_NAME=agrivision_db

# Groq LLM API (Multilingual Krishi AI Assistant & Agronomy Inference)
# Sign up free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# YouTube Data API v3 (Official Hindi Video Academy & Extension Lectures)
# Obtain via Google Cloud Console: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Open-Meteo Weather Provider
# Open-Meteo is free for non-commercial & educational use (No API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1

# Official Indian Open Government Data (data.gov.in / Agmarknet Mandi)
# Register at: https://data.gov.in/
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# File Storage
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_BYTES=15728640

# Optional Email Notification Provider (SMTP for verification & password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_notifications_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="AgriVision AI Alerts"

# Optional Translation & Speech Adapters
TRANSLATION_PROVIDER=offline_hybrid  # Options: offline_hybrid, google_cloud, bhashini
SPEECH_RECOGNITION_PROVIDER=browser_native # Options: browser_native, whisper_api
TTS_PROVIDER=browser_native # Options: browser_native, elevenlabs
